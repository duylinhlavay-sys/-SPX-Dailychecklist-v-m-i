{
  "name": "daily-checklist",
  "version": "2.0.0",
  "description": "Modern task management app with glassmorphism design, dark mode, and offline support",
  "main": "app.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "eslint app.js virtual-scroll.js firebase-config.js",
    "format": "prettier --write \"**/*.{js,html,css,md}\"",
    "build": "echo 'No build step required for static site'",
    "serve": "python -m http.server 8000",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:vercel": "vercel --prod"
  },
  "keywords": [
    "todo",
    "checklist",
    "task-manager",
    "pwa",
    "offline",
    "glassmorphism"
  ],
  "author": "SPX Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "app.js",
      "virtual-scroll.js",
      "firebase-config.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ]
  }
}
